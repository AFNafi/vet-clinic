# Local server configuration only. Do not commit a real .env file.
PORT=3000

# Oracle Database Free in the local Docker container.
# Copy this file to .env and enter the VET schema password privately.
DB_USER=VET
DB_PASSWORD=
DB_CONNECT_STRING=localhost:1522/FREEPDB1

# Optional staff-registration invitations; each code must be at least 16 characters.
ADMIN_REGISTRATION_CODE=
VETERINARIAN_REGISTRATION_CODE=
